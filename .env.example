# DigitalOcean Managed Database Configuration
DB_HOST=your-db-host.ondigitalocean.com
DB_PORT=25060
DB_NAME=your_database_name
DB_USER=doadmin
DB_PASSWORD=your_database_password
DB_ROOT_PASSWORD=your_database_password

# WordPress Configuration
TABLE_PREFIX=wp_
WP_DEBUG=true
WP_DEBUG_LOG=true
WP_DEBUG_DISPLAY=false

# Site URL (for local development)
SITE_URL=http://localhost:8080

# DigitalOcean Spaces Configuration (for media CDN)
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_ENDPOINT=region.digitaloceanspaces.com
DO_SPACES_CDN_ENDPOINT=your-bucket-name.region.cdn.digitaloceanspaces.com
DO_SPACES_REGION=region
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
BUCKET_SITE_PATH=your-site-folder
