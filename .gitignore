# WordPress Core (downloaded during build)
/wp-admin/
/wp-includes/
wp-*.php
index.php         # WordPress core file (not the placeholder!)
xmlrpc.php
license.txt
readme.html

# WordPress Content
# Allow wp-content but manage specific subdirectories
wp-content/uploads/     # Served from DO Spaces
wp-content/plugins/     # Managed via plugins.txt manifest
wp-content/themes/      # Managed via themes.txt manifest (except default themes from core)
wp-content/cache/
wp-content/upgrade/
wp-content/backup-db/
wp-content/*.log

# WordPress Config (generated during build)
wp-config.php

# Build artifacts
wordpress.tar.gz

# Docker files (keep Dockerfile and docker-compose.yml in git)
# Local override only:
docker-compose.override.yml

# Backup files
*.bak
index.php.bak

# Local development
.env
.DS_Store
.vscode/
*.log

# Dependencies
node_modules/
vendor/
