# WordPress Core (downloaded during build)
/wp-admin/
/wp-includes/
wp-*.php
index.php         # WordPress core file (not the placeholder!)
xmlrpc.php
license.txt
readme.html

# WordPress Content
# Completely ignore wp-content - it's generated fresh during Docker build
# - Core files from WordPress download
# - Plugins installed from plugins.txt manifest  
# - Themes installed from themes.txt manifest
# - Must-use plugins created in Dockerfile
# - Uploads served from DigitalOcean Spaces
wp-content/

# WordPress Config (generated during build)
wp-config.php

# Build artifacts
wordpress.tar.gz

# Docker files (keep Dockerfile and docker-compose.yml in git)
# Local override only:
docker-compose.override.yml

# Backup files
*.bak
index.php.bak

# Local development
.env
.DS_Store
.vscode/
*.log

# Secrets and credentials
DO-SECRETS.md
app-spec-docker-with-secrets.yaml
*-with-secrets.*

# Dependencies
node_modules/
vendor/
